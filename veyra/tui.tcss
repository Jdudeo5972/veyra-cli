Screen {
    background: $background;
    color: $foreground;
}
#workspace {
    width: 100%;
    height: 1fr;
    padding: 1 3;
}
#workspace.home {
    align: center middle;
}
#wordmark {
    height: 5;
    width: 1fr;
    content-align: center middle;
    text-align: center;
    margin-bottom: 3;
}
#conversation {
    height: 1fr;
    width: 1fr;
    scrollbar-size: 1 1;
}
.home #conversation {
    display: none;
}
.conversation-mode #wordmark {
    display: none;
}
.home.completing #wordmark {
    display: none;
}
#prompt-area {
    height: auto;
    width: 1fr;
}
#prompt-wrapper {
    height: auto;
    width: 1fr;
    align: center top;
}
.home #prompt-area {
    width: 78;
    max-width: 100%;
}
.conversation-mode #prompt-area {
    margin-top: 1;
}
#composer-panel {
    height: auto;
    background: $surface;
    border-left: thick $primary;
    padding: 1 2;
}
#composer {
    height: 2;
    max-height: 6;
    min-height: 2;
    border: none;
    padding: 0;
    background: $surface;
}
#composer:focus {
    border: none;
}
#model-line {
    height: auto;
    margin-top: 1;
}
#input-hints {
    height: auto;
    min-height: 1;
    margin-top: 1;
}
#metrics {
    height: auto;
    width: 1fr;
    color: $text-muted;
}
#shortcuts {
    height: auto;
    width: auto;
    max-width: 50%;
    color: $text-muted;
    text-align: right;
}
#session-bar {
    height: 1;
    margin: 0 3 1 3;
    color: $text-muted;
}
#session-info {
    width: 1fr;
    height: 1;
}
#version-info {
    width: auto;
    height: 1;
    text-align: right;
}
.chat-message {
    height: auto;
    margin-bottom: 2;
}
.user-message {
    background: $panel;
    border-left: thick $primary;
    padding: 1 2;
}
.user-message .message-role {
    display: none;
}
.assistant-message {
    padding: 0 2;
}
.message-role {
    color: $accent;
    height: 1;
    margin-bottom: 1;
}
.message-body {
    height: auto;
    margin: 0;
    padding: 0;
}
Markdown {
    background: transparent;
    margin: 0;
    padding: 0;
}
MarkdownFence {
    background: $surface;
    margin: 1 0;
}
.command-output {
    height: auto;
    margin: 0 2 1 2;
}
#completions {
    display: none;
    height: auto;
    max-height: 9;
    border: none;
    background: $surface;
    margin-bottom: 1;
}
ModalScreen {
    align: center middle;
    background: $background 75%;
}
.dialog {
    width: 76;
    max-width: 95%;
    height: 70%;
    padding: 1 2;
    background: $surface;
    border: solid $primary-muted;
}
.dialog-title {
    color: $primary;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}
.dialog Input {
    margin-bottom: 1;
}
#picker-options {
    height: 1fr;
    border: none;
}
.question {
    height: auto;
    max-height: 90%;
}
.dialog-buttons {
    height: 3;
}
.dialog-buttons Button {
    margin-right: 1;
}
